import React, { useEffect } from 'react';
import { Html5QrcodeScanner } from 'html5-qrcode';
import { X } from 'lucide-react';

export default function ScannerModal({ abierto, alDetectar, alCerrar }) {
  useEffect(() => {
    if (!abierto) return;

    const scanner = new Html5QrcodeScanner(
      'lector-camara',
      {
        fps: 10,
        qrbox: { width: 250, height: 150 },
        rememberLastUsedCamera: true,
      },
      false
    );

    scanner.render(
      (textoDecodificado) => {
        scanner.clear();
        alDetectar(textoDecodificado);
        alCerrar();
      },
      (error) => {
        // Ignorar errores de frame vacío
      }
    );

    return () => {
      scanner.clear().catch(() => {});
    };
  }, [abierto]);

  if (!abierto) return null;

  return (
    <div style={estilos.overlay}>
      <div style={estilos.modal}>
        <div style={estilos.header}>
          <h3 style={{ margin: 0, fontSize: '1rem' }}>Escanear Código de Barras</h3>
          <button onClick={alCerrar} style={estilos.btnCerrar}>
            <X size={20} />
          </button>
        </div>
        <div id="lector-camara" style={{ width: '100%' }}></div>
        <p style={{ fontSize: '0.8rem', color: '#666', textAlign: 'center', marginTop: '10px' }}>
          Apunta la cámara al código EAN-13 del producto
        </p>
      </div>
    </div>
  );
}

const estilos = {
  overlay: {
    position: 'fixed',
    top: 0,
    left: 0,
    right: 0,
    bottom: 0,
    backgroundColor: 'rgba(0,0,0,0.7)',
    display: 'flex',
    justifyContent: 'center',
    alignItems: 'center',
    zIndex: 9999,
    padding: '15px',
  },
  modal: {
    background: '#fff',
    borderRadius: '12px',
    width: '100%',
    maxWidth: '380px',
    padding: '16px',
    boxShadow: '0 4px 20px rgba(0,0,0,0.3)',
  },
  header: {
    display: 'flex',
    justifyContent: 'space-between',
    alignItems: 'center',
    marginBottom: '12px',
  },
  btnCerrar: {
    background: 'none',
    border: 'none',
    cursor: 'pointer',
    padding: '4px',
  },
};
